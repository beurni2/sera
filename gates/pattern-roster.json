      "regex": "/(arbre[_-]?(de|des|du)?[_-]?(parrainage|filleul|revendeu|affili|[ée]quipe)|(?<![a-zA-ZÀ-ÿ])lign[ée]e|(?<![a-zA-ZÀ-ÿ])descendance)/i"
