{
  "expo": {
    "name": "Séra",
    "slug": "sera-rider",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFDF7",
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "package": "bf.sera.rider"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Instrument-400.ttf",
            "./assets/fonts/Instrument-500.ttf",
            "./assets/fonts/Instrument-600.ttf",
            "./assets/fonts/Instrument-700.ttf",
            "./assets/fonts/Bricolage-700.ttf",
            "./assets/fonts/Bricolage-800.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Séra utilise l'appareil photo pour la photo de preuve du colis.",
          "photosPermission": "Séra n'ouvre vos photos que si vous choisissez d'en envoyer une comme preuve."
        }
      ]
    ]
  }
}
